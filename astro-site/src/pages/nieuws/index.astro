---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/wordpress';

const posts = await getPosts();
const dateFormat = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Nieuws">
  <Header />
  <main class="py-20 sm:py-28">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <h1 class="font-display font-bold text-4xl text-ink-900">Nieuws</h1>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/nieuws/${post.slug}`}
            class="block rounded-2xl bg-warm-50 border border-ink-900/5 p-6 shadow-[0_8px_24px_-12px_rgba(58,14,24,0.12)] hover:shadow-[0_16px_32px_-16px_rgba(58,14,24,0.2)] transition-shadow"
          >
            <h2 class="font-display font-semibold text-lg text-ink-900" set:html={post.title} />
            <time datetime={post.date} class="mt-1 block text-xs text-ink-500">
              {dateFormat.format(new Date(post.date))}
            </time>
            <div class="mt-2 text-ink-700 text-sm leading-relaxed" set:html={post.excerpt} />
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
