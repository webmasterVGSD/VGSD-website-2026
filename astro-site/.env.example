# Kopieer dit bestand naar .env en vul in zodra er een echte WordPress-backend
# draait. Zolang deze leeg/afwezig zijn, gebruikt de site automatisch mock-data
# uit src/lib/mock-data.ts (zie src/lib/wordpress.ts).

# Basis-URL van de WordPress REST API, bv. https://api.vgsd.nl/wp-json
WORDPRESS_API_URL=

# URL van de inlogpagina op het besloten ledenportaal-subdomein,
# bv. https://leden.vgsd.nl/wp-login.php
WORDPRESS_MEMBERS_URL=
